# AcadConnect Frontend Environment Variables
# These variables are required for the frontend to communicate with backend microservices.

# User Service (Node.js) - handles auth, profile, and notifications
VITE_USER_SERVICE_URL=http://localhost:3001/api
VITE_USER_SERVICE_WS_URL=ws://localhost:3001/ws

# Project Service (Node.js) - handles project management and collaborations
VITE_PROJECT_SERVICE_URL=http://localhost:3002/api

# AI Feedback Service (Python) - handles lexical similarity and help chat
VITE_AI_FEEDBACK_SERVICE_URL=http://localhost:8001/api

# Recommendation Service (Python) - handles project/student matching
VITE_RECOMMENDATION_SERVICE_URL=http://localhost:8002/api
