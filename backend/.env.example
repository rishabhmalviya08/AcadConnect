# ─── PostgreSQL ───────────────────────────────────────────
POSTGRES_USER=acadconnect
POSTGRES_PASSWORD=yourStrongPassword
POSTGRES_DB=acadconnect
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ─── MongoDB ──────────────────────────────────────────────
MONGO_USER=acadconnect
MONGO_PASSWORD=yourStrongPassword
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=acadconnect_nlp
MONGO_URI=mongodb://acadconnect:yourStrongPassword@localhost:27017/acadconnect_nlp?authSource=admin

# ─── User Service ─────────────────────────────────────────
USER_SERVICE_PORT=3001

# ─── Project Service ──────────────────────────────────────
PROJECT_SERVICE_PORT=3002
# AI feedback: lexical similarity scan (most recently updated projects first)
SIMILARITY_SCAN_MAX=2000
SIMILARITY_TOP_K=15

# ─── JWT ──────────────────────────────────────────────────
JWT_SECRET=replaceWithA64CharRandomSecret
JWT_EXPIRES_IN=7d

# ─── AI Services (added in later steps) ───────────────────
# Use a real key from https://platform.openai.com/account/api-keys — the placeholder below will return HTTP 401.
OPENAI_API_KEY="your-openai-api-key-here"

# 1 = stubbed project AI feedback (no OpenAI); use for local dev without a billing key
OPENAI_FEEDBACK_MOCK=0

# project-service → ai-feedback-service (no trailing slash). Local: http://localhost:8001
AI_FEEDBACK_SERVICE_URL=http://localhost:8001

# FAQ Help chat (/api/chat/faq): requests per minute per user or IP
CHAT_RATE_LIMIT_PER_MINUTE=20
# OpenAI project feedback (/api/feedback/generate, /api/feedback/generate-sync): per user (JWT) or IP
OPENAI_FEEDBACK_RATE_LIMIT_PER_MINUTE=8
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=

# ─── SendGrid (added in Step 6) ───────────────────────────
SENDGRID_API_KEY=
