MONGO_URI=mongodb://acadconnect:yourStrongPassword@localhost:27017/acadconnect_nlp?authSource=admin
MONGO_DB=acadconnect_nlp
OPENAI_API_KEY=your_openai_api_key_here
AI_FEEDBACK_SERVICE_PORT=8001

# Same secret as backend user-service (FAQ chat JWT role hint). Optional if chat unused.
JWT_SECRET=

# FAQ chat rate limit per minute per user (or IP if unauthenticated).
CHAT_RATE_LIMIT_PER_MINUTE=20

# OpenAI feedback (generate + generate-sync): stricter cap per user or IP per minute
OPENAI_FEEDBACK_RATE_LIMIT_PER_MINUTE=8

# Optional: override OpenAI chat model for /api/chat/faq
# OPENAI_CHAT_MODEL=gpt-4o-mini

# Optional CSV of browser origins for CORS (helps Help widget from Vite dev server).
# CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
